<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-configuration PUBLIC
        "-//Hibernate/Hibernate Configuration DTD 3.0//EN"
        "http://www.hibernate.org/dtd/hibernate-configuration-3.0.dtd">

<hibernate-configuration>
    <session-factory>
        <!-- 1. Propiedades de conexión de la Base de Datos -->
        <property name="connection.driver_class">org.postgresql.Driver</property>
        <property name="connection.url">jdbc:postgresql://localhost:5432/hangar_imperio_db</property>
        <property name="connection.username">antonio</property>
        <property name="connection.password">admin</property>

        <!-- 2. Dialecto SQL específico para optimizar las consultas a PostgreSQL -->
        <property name="dialect">org.hibernate.dialect.PostgreSQLDialect</property>

        <!-- 3. Propiedades de depuración del desarrollador -->
        <!-- Muestra por la consola de NetBeans las sentencias SQL que Hibernate genera por detrás -->
        <property name="show_sql">true</property>
        <!-- Formatea el código SQL de la consola para que sea legible -->
        <property name="format_sql">true</property>

        <!-- 4. Estrategia de creación de tablas automático -->
        <!-- 'update' actualiza la estructura de las tablas existentes sin borrar los datos -->
        <property name="hbm2ddl.auto">update</property>

        <!-- Aquí se declararán más adelante las clases mapeadas/entidades -->
        <!-- <mapping class="ut4.modelo.NaveEntity"/> -->
        <mapping class="org.dam.accesodatos.ut4.examen.models.Nave"/>
        <mapping class="org.dam.accesodatos.ut4.examen.models.CazaLigero"/>
        <mapping class="org.dam.accesodatos.ut4.examen.models.DestructorEstelar"/>
        <mapping class="org.dam.accesodatos.ut4.examen.models.Planeta"/>
    </session-factory>
</hibernate-configuration>